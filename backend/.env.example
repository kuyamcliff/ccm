# Copy to .env and fill in. The server refuses to start in production if any
# required value here is missing or too weak.

# development | production
NODE_ENV=development

PORT=4000

# Signs session cookies. Must be at least 32 characters in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Signs the QR code on booking receipts. Must be at least 32 characters and
# different from JWT_SECRET. Changing it invalidates every receipt already
# issued, so treat it as long-lived.
QR_SIGNING_SECRET=

# Where the site is served from. Must be https:// in production.
# Used to reject cross-origin state changes.
FRONTEND_URL=http://localhost:5173

# Extra origins allowed to make state-changing requests, comma separated.
# Leave empty unless the site is served from more than one hostname.
EXTRA_ORIGINS=


# ── Email (Resend) ───────────────────────────────────────────────────────
# Powers the self-service "forgot password" link. Leave RESEND_API_KEY empty
# and that feature stays switched off: the sign-in page then tells people to
# message support, and you issue reset links from Admin > Users instead.
# Nothing else on the site depends on email.

# From https://resend.com/api-keys — starts with "re_". Sending permission is
# all it needs.
RESEND_API_KEY=

# Must be an address on a domain you have verified at
# https://resend.com/domains. Until you verify one, Resend only accepts the
# shared test sender below, and only to your own account's address.
EMAIL_FROM=Cam Chop Meat <onboarding@resend.dev>

# Optional. Where replies go, if different from the from address.
EMAIL_REPLY_TO=


# ── MTN MoMo Collections ─────────────────────────────────────────────────
# From https://momodeveloper.mtn.com after subscribing to the Collection
# product. See MOMO-SETUP.md for how to obtain each of these.

# "Primary Key" on your MoMo developer profile, under the Collection product.
MOMO_SUBSCRIPTION_KEY=

# The API User UUID and its API Key, provisioned against the subscription key.
MOMO_API_USER=
MOMO_API_KEY=

# `sandbox` while testing. MTN gives you the live value when your production
# account is approved — the server refuses to start in production on `sandbox`.
MOMO_TARGET_ENVIRONMENT=sandbox

# Sandbox host below. In production MTN issues you a country-specific host.
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com

# Sandbox only settles in EUR. Leave unset in production to default to XAF.
# MOMO_CURRENCY=XAF

# ── Outgoing SMS (MTN SMS v3 API) ────────────────────────────────────────
# From https://developers.mtn.com after registering an App against the
# "SMS v3 API" product. A different portal from MoMo Collections above. See
# SMS-SETUP.md for how to obtain each of these and what to give MTN as the
# callback and delivery report URLs.
# Until these are set, every message is still composed, addressed and written
# to the notifications table with status 'logged' — it just is not delivered.
# That makes the wiring checkable before a provider is paid for.

# Consumer key and secret for the registered App.
MTN_SMS_CLIENT_ID=
MTN_SMS_CLIENT_SECRET=

# The approved short code messages go out under.
MTN_SMS_SERVICE_CODE=

# Optional alphanumeric sender name, if the account has one. Takes precedence
# over the service code when set.
MTN_SMS_SENDER_ADDRESS=

# MTN_SMS_BASE_URL=https://api.mtn.com

# A secret this server puts in the path of the delivery report URL it hands
# to MTN, since that callback carries no signature of its own to check.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SMS_CALLBACK_SECRET=

# Country code assumed for a local number typed without one. 237 is Cameroon.
DEFAULT_PHONE_COUNTRY_CODE=237

node_modules/
dist/
backend/data/

# Every env file, however it is suffixed. A plain `.env` rule misses the
# backups people leave behind (.env.bak, .env.local, .env.old), which is
# exactly how live credentials end up in a public repository.
.env
.env.*
!.env.example

# Python bytecode caches, which the bundled skill scripts regenerate on every run.
__pycache__/
*.pyc

# TypeScript incremental build state, rewritten on every typecheck.
*.tsbuildinfo
